# Bu dosyayı server/.env olarak kopyalayıp değerleri doldurun

# Sunucu portu
PORT=4000

# JWT imzalama anahtarı (üretimde mutlaka uzun ve rastgele bir değer verin)
JWT_SECRET=buraya-uzun-rastgele-bir-anahtar

# PDF üretimi için Chrome/Chromium yolu (otomatik bulunamazsa)
# Linux örnek: /usr/bin/chromium
# CHROME_PATH=
