# Bu dosyayı server/.env olarak kopyalayıp değerleri doldurun

# Sunucu portu
PORT=4000

# JWT imzalama anahtarı (en az 32 karakter, uzun ve rastgele).
# Boş bırakılırsa ilk çalıştırmada üretilip server/.jwt_secret dosyasına yazılır.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# Yeni hesap açma. Varsayılan kapalı; yalnızca ilk kullanıcı kendi kendine kayıt olabilir.
# Kullanıcı eklemek için geçici olarak true yapıp sunucuyu yeniden başlatın.
# ALLOW_REGISTRATION=false

# Arayüz başka bir adresten API'ye erişecekse izin verilen kaynaklar (virgülle ayrılmış)
# CORS_ORIGIN=https://ornek.gov.tr

# PDF üretimi için Chrome/Chromium yolu (otomatik bulunamazsa)
# Linux örnek: /usr/bin/chromium
# CHROME_PATH=
